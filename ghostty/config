# cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# terminal size
window-width = 130
window-height = 40

# cursor shader
# custom-shader = shaders/cursor_smear_fade.glsl

# font
font-family = "MesloLGS NF"
# font-family = "JetBrainsMono Nerd Font"
#font-size = 14
font-style = regular
bold-is-bright = true

# background & colors
background = 1e1e1e
theme = Terminal Basic Dark

# SSH tomfoolery
shell-integration-features = ssh-terminfo,ssh-env

# annoying ahh message removed
clipboard-paste-protection = false

# mouse scroll distance
mouse-scroll-multiplier = precision:1,discrete:0.5
