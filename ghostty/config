# cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# font
font-family = "MesloLGS NF"
# font-size = 14
font-style = regular
bold-is-bright = true

# background & colors
background = 1e1e1e
theme = Terminal Basic Dark

# SSH tomfoolery
shell-integration-features = ssh-terminfo,ssh-env