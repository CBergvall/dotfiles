<?xml version="1.0" encoding="utf-8"?>
<layout onVolumeUp="volume_up" onVolumeDown="volume_down" >
	<row>
		<grid>
			<row>
				<button text="Open Media Folder" ontap="open_media_folder" />
				<button text="Open Youtube" ontap="open_youtube" />
				<button text="Open Spotify" ontap="open_spotify" />
			</row>
			<row>
				<button text="Bluetooth Audio" ontap="headphones2_output" />
				<button text="Wired Audio" ontap="headphones_output" />
				<button text="TV Audio" ontap="tv_output" />
			</row>
		</grid>
	</row>
	<row>
		<button text="Refocus (test)" ontap="refocus" />
		<button text="C" ontap="captions" />
		<button icon="refresh" ontap="refresh" />
		<button text="Youtube Home" ontap="youtube_home" />
	</row>
	<row>
		<button icon="arrowleft" ontap="skip_backwards" />
		<button text="Space" ontap="pause" />
		<button icon="arrowright" ontap="skip_forwards" />
	</row>
	<row>
		<button icon="up" ontap="scroll_up" />
		<button icon="down" ontap="scroll_down" />
	</row>
	<row>
		<button text="F" ontap="fullscreen" />
		<grid>
			<row>
				<button text="F11" ontap="funceleven" />
				<grid>
					<row>
						<button icon="zoomin" ontap="zoom_in" />
					</row>
					<row>
						<button icon="zoomout" ontap="zoom_out" />
					</row>
				</grid>
			</row>
		</grid>
	</row>
</layout>